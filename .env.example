APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_BASE_PATH=/

ANDROID_PLATFORM_NAME=Android
ANDROID_AUTOMATION_NAME=UiAutomator2
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=15
ANDROID_APP_PROFILE=settings
ANDROID_UDID=
ANDROID_AVD=
ANDROID_NO_RESET=false
ANDROID_FULL_RESET=false
ANDROID_NEW_COMMAND_TIMEOUT=240

# Optional overrides for preinstalled Settings app
ANDROID_SETTINGS_PACKAGE=com.android.settings
ANDROID_SETTINGS_ACTIVITY=com.android.settings.Settings

# Optional absolute path override if you want to point to a custom APK
ANDROID_APP_PATH=

WDIO_LOG_LEVEL=info
